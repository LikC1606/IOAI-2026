        "task1/remote/FINAL_ACCOUNT_RESULTS.json",
        "task2/remote/FINAL_ACCOUNT_RESULTS.json",
        "task3/remote/FINAL_ACCOUNT_RESULTS.json",
        "task4/remote/FINAL_ACCOUNT_RESULTS.json",
        "task5/remote/FINAL_ACCOUNT_RESULTS.json",
        "task6/remote/FINAL_ACCOUNT_RESULTS.json"
      ]
    },
    "human_intervention_exclusion": {
      "status": "complete",
      "selection_path": "AUTONOMOUS_TRACE_INDEX.json",
      "manifest_path": "AUTONOMOUS_MATERIAL_MANIFEST.sha256",
      "rule": "The first excluded live-human prompt and every causally downstream event are outside the selected trace set. Boundary evidence is hash-only."
